// Package server wires HTTP routes and middleware.
package server

import (
	"encoding/json"
	"log"
	"net/http"
	"strings"

	"github.com/rs/cors"
	"gorm.io/gorm"
)

// Server holds the dependencies HTTP handlers need.
type Server struct {
	DB *gorm.DB
}

// New builds a ready-to-serve http.Handler: routes, CORS, and panic
// recovery.
func (s *Server) New(corsOrigins string) http.Handler {
	mux := http.NewServeMux()
	s.routes(mux)

	var origins []string
	if corsOrigins == "" || corsOrigins == "*" {
		origins = []string{"*"}
	} else {
		origins = strings.Split(corsOrigins, ",")
	}
	handler := cors.New(cors.Options{
		AllowedOrigins: origins,
		AllowedMethods: []string{http.MethodGet, http.MethodPost, http.MethodPut, http.MethodDelete},
	}).Handler(mux)

	return recoverMiddleware(handler)
}

func (s *Server) routes(mux *http.ServeMux) {
	mux.HandleFunc("GET /api/health", s.handleHealth)
	mux.HandleFunc("GET /api/hello", s.handleHello)
}

func (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {
	writeJSON(w, http.StatusOK, map[string]string{"status": "ok"})
}

// handleHello is a placeholder route proving routing and the JSON response
// helper work end to end. Replace it with your own handlers.
func (s *Server) handleHello(w http.ResponseWriter, r *http.Request) {
	writeJSON(w, http.StatusOK, map[string]string{"message": "hello from {{APP_NAME}}"})
}

func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}

func recoverMiddleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if err := recover(); err != nil {
				log.Printf("panic: %v", err)
				writeJSON(w, http.StatusInternalServerError, map[string]string{"error": "internal server error"})
			}
		}()
		next.ServeHTTP(w, r)
	})
}
