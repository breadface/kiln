<?xml version="1.0" encoding="utf-8"?>
<!-- Merged only into debug builds — wires up the debug-only network security
     config below so local dev cleartext HTTP traffic to the emulator/LAN
     backend isn't blocked. Never merged into release builds, which stay
     HTTPS-only by Android's own default. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
