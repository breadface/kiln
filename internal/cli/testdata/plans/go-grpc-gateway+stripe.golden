==> demo-api/.env.example <==
# Copy to .env and fill in real values before running locally.

PORT=8080
GRPC_PORT=9090
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demo?sslmode=disable
JWT_SECRET=change-me-in-production
CORS_ORIGINS=*
# --- backend/go-grpc-gateway for payments/stripe (payment-provider@1) ---
# Payments: "fake" serves a local checkout page so you can test without a
# stripe account. Leave unset in production, where it defaults to stripe.
PAYMENTS_PROVIDER=fake
# --- payments/stripe for backend/go-grpc-gateway (go-backend@1) ---
# Stripe — only read when PAYMENTS_PROVIDER=stripe (or unset). Test-mode
# keys: Dashboard → Developers. Forward webhooks locally with
#   stripe listen --forward-to localhost:8080/api/payments/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GRPC_PORT is internal only (the REST gateway dials it in process) —
# never expose it outside the container/host, unlike PORT.
#
# Postgres is assumed to be externally managed (a local install, or a
# managed provider) — this project doesn't run Postgres itself, locally or
# in production. Point DATABASE_URL above at whichever instance you use.

==> demo-api/main.go <==
// Command demo-api is the gRPC + REST gateway API entrypoint.
package main

import (
	"context"
	"flag"
	"log"
	"net"
	"net/http"

	"github.com/grpc-ecosystem/grpc-gateway/v2/runtime"
	"google.golang.org/grpc"
	"google.golang.org/grpc/credentials/insecure"

	"github.com/example/demo-api/config"
	"github.com/example/demo-api/db"
	greeterv1 "github.com/example/demo-api/proto/pb/greeter"
	"github.com/example/demo-api/server"
	// --- backend/go-grpc-gateway for payments/stripe (payment-provider@1) ---
	"github.com/example/demo-api/payments"
	"github.com/example/demo-api/payments/adapters"
)

func main() {
	migrate := flag.Bool("migrate", false, "run database migrations and exit")
	flag.Parse()

	cfg, err := config.Load()
	if err != nil {
		log.Fatalf("loading config: %v", err)
	}

	conn, err := db.Connect(cfg.DatabaseURL)
	if err != nil {
		log.Fatalf("connecting to database: %v", err)
	}

	if *migrate {
		if err := db.Migrate(conn); err != nil {
			log.Fatalf("migrating: %v", err)
		}
		// --- backend/go-grpc-gateway for payments/stripe (payment-provider@1) ---
		if err := payments.Migrate(conn); err != nil {
			log.Fatalf("migrating payments: %v", err)
		}
		log.Println("migrations complete")
		return
	}

	// Plugins append functions here that register their own HTTP handlers
	// alongside the gateway, e.g. webhooks that need the raw request.
	var routes []func(*http.ServeMux)
	// --- backend/go-grpc-gateway for payments/stripe (payment-provider@1) ---
	paymentsService, err := payments.New(conn, adapters.All)
	if err != nil {
		log.Fatalf("payments: %v", err)
	}
	routes = append(routes, paymentsService.Routes)

	grpcServer := grpc.NewServer()
	greeterv1.RegisterGreeterServer(grpcServer, server.NewGreeterServer(conn))

	grpcLis, err := net.Listen("tcp", ":"+cfg.GRPCPort)
	if err != nil {
		log.Fatalf("listening on grpc port: %v", err)
	}
	go func() {
		log.Printf("grpc listening on :%s (internal)", cfg.GRPCPort)
		if err := grpcServer.Serve(grpcLis); err != nil {
			log.Fatalf("grpc server error: %v", err)
		}
	}()

	gwConn, err := grpc.NewClient("localhost:"+cfg.GRPCPort, grpc.WithTransportCredentials(insecure.NewCredentials()))
	if err != nil {
		log.Fatalf("dialing grpc server: %v", err)
	}

	gwmux := runtime.NewServeMux()
	if err := greeterv1.RegisterGreeterHandler(context.Background(), gwmux, gwConn); err != nil {
		log.Fatalf("registering gateway handler: %v", err)
	}

	log.Printf("gateway listening on :%s", cfg.Port)
	if err := http.ListenAndServe(":"+cfg.Port, server.WrapGateway(gwmux, cfg.CORSOrigins, routes...)); err != nil {
		log.Fatalf("gateway server error: %v", err)
	}
}

==> demo-api/payments/adapters/adapters.go <==
// Package adapters lists the payment providers compiled into this app.
// Provider plugins add themselves here; the fake provider is built into
// package payments.
package adapters

import (
	"github.com/example/demo-api/payments"
	// --- payments/stripe for backend/go-grpc-gateway (go-backend@1) ---
	"github.com/example/demo-api/payments/stripe"
)

// All is every provider PAYMENTS_PROVIDER can select.
var All = payments.Providers{
	// --- payments/stripe for backend/go-grpc-gateway (go-backend@1) ---
	"stripe": stripe.New,
}

==> deploy.sh <==
#!/usr/bin/env bash
# Deploys this project as the Docker Swarm stack "demo". Runs
# anywhere — CI or your machine — and talks to the swarm manager's Docker
# over SSH using the files in this repository, so nothing needs copying to
# the server first.
#
# Environment:
#   DEPLOY_HOST         swarm manager hostname or IP (required unless DOCKER_HOST is set)
#   DEPLOY_USER         SSH user there that can run docker (default: root)
#   DEPLOY_SSH_KEY      private key to log in with (default: your SSH agent/config)
#   DEPLOY_KNOWN_HOSTS  known_hosts line(s) for DEPLOY_HOST (default: trust on first use)
#   IMAGE_TAG           image tag to deploy (default: latest). Use a unique tag per
#                       deploy, e.g. a commit SHA — config files are versioned by it.
#   DOCKER_HOST         set instead of DEPLOY_HOST to target any Docker daemon directly
#
# Also needed: a .env file here with the application's runtime variables
# (NAME=value lines, values unquoted), and docker logged in to
# ghcr.io, e.g.:
#   echo "$GHCR_TOKEN" | docker login ghcr.io -u example --password-stdin
#
# Usage:
#   DEPLOY_HOST=203.0.113.10 IMAGE_TAG=abc1234 ./deploy.sh

set -euo pipefail
cd "$(dirname "$0")"

export IMAGE_TAG=${IMAGE_TAG:-latest}

if [ -z "${DOCKER_HOST:-}" ]; then
	: "${DEPLOY_HOST:?set DEPLOY_HOST (or DOCKER_HOST)}"
	if [ -n "${DEPLOY_SSH_KEY:-}" ]; then
		eval "$(ssh-agent -s)" >/dev/null
		trap 'ssh-agent -k >/dev/null' EXIT
		printf '%s\n' "$DEPLOY_SSH_KEY" | ssh-add - >/dev/null 2>&1
	fi
	mkdir -p ~/.ssh && chmod 700 ~/.ssh
	if [ -n "${DEPLOY_KNOWN_HOSTS:-}" ]; then
		printf '%s\n' "$DEPLOY_KNOWN_HOSTS" >>~/.ssh/known_hosts
	elif ! ssh-keygen -F "$DEPLOY_HOST" >/dev/null 2>&1; then
		echo "warning: trusting $DEPLOY_HOST's SSH host key on first use; set DEPLOY_KNOWN_HOSTS to pin it" >&2
		ssh-keyscan -H "$DEPLOY_HOST" >>~/.ssh/known_hosts 2>/dev/null
	fi
	export DOCKER_HOST="ssh://${DEPLOY_USER:-root}@$DEPLOY_HOST"
fi

# Export .env for ${VAR} interpolation in the compose files: unlike
# `docker compose`, `docker stack deploy` doesn't read .env itself. Lines
# are taken literally (no shell evaluation), the same way --env-file does.
if [ -f .env ]; then
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in '' | '#'*) continue ;; esac
		export "${line%%=*}=${line#*=}"
	done <.env
fi

docker swarm init >/dev/null 2>&1 || true

# Pull with retry — a registry can take a moment to serve a freshly
# pushed image.
# --- runtime/docker-swarm for backend/go-grpc-gateway (oci-image@1) ---
for i in 1 2 3 4 5; do
	docker pull "ghcr.io/example/demo-api:$IMAGE_TAG" && break
	if [ "$i" = 5 ]; then exit 1; fi
	echo "pull attempt $i failed, retrying..."
	sleep 5
done

# --- runtime/docker-swarm for backend/go-grpc-gateway (migration@1) ---
echo "=== Running migrations: demo-api ==="
docker run --rm \
	--env-file .env \
	"ghcr.io/example/demo-api:$IMAGE_TAG" \
	./api-server -migrate

echo "=== Deploying stack demo ($IMAGE_TAG) ==="
for i in 1 2 3; do
	docker stack deploy \
		--with-registry-auth \
		--prune \
		-c docker-compose.yml \
		-c docker-compose.swarm.yml \
		demo && break
	if [ "$i" = 3 ]; then exit 1; fi
	echo "stack deploy attempt $i failed, retrying..."
	sleep 5
done

echo "=== Verifying rollout ==="
# --- runtime/docker-swarm for backend/go-grpc-gateway (oci-image@1) ---
service="demo_demo-api"
converged=""
for i in $(seq 1 20); do
	states=$(docker service ps "$service" --filter "desired-state=running" --format '{{.CurrentState}}' 2>/dev/null || true)
	if [ -n "$states" ] && ! echo "$states" | grep -qv '^Running'; then
		converged=1
		break
	fi
	sleep 3
done
if [ -z "$converged" ]; then
	echo "rollout did not converge for $service in time" >&2
	docker service ps "$service" || true
	exit 1
fi
echo "rollout complete: $service"

docker image prune -f >/dev/null
echo "=== Done ==="

==> docker-compose.swarm.yml <==
# Generated by kiln from plugins: backend/go-grpc-gateway, payments/stripe, edge/caddy, registry/ghcr, runtime/docker-swarm, ci/github-actions
configs:
    caddyfile:
        file: ./Caddyfile
        name: demo_caddyfile_${IMAGE_TAG:-latest}
networks:
    default:
        attachable: true
        driver: overlay
services:
    demo-api:
        deploy:
            replicas: 1
            restart_policy:
                condition: on-failure
            update_config:
                failure_action: rollback
                monitor: 30s
                order: start-first
        image: ghcr.io/example/demo-api:${IMAGE_TAG:-latest}

==> docker-compose.yml <==
# Generated by kiln from plugins: backend/go-grpc-gateway, payments/stripe, edge/caddy, registry/ghcr, runtime/docker-swarm, ci/github-actions
configs:
    caddyfile:
        file: ./Caddyfile
services:
    caddy:
        configs:
            - source: caddyfile
              target: /etc/caddy/Caddyfile
        image: caddy:2-alpine
        ports:
            - 80:80
            - 443:443
        restart: always
        volumes:
            - caddy_data:/data
            - caddy_config:/config
    demo-api:
        build:
            context: ./demo-api
            dockerfile: Dockerfile
        container_name: demo-api
        dns:
            - 8.8.8.8
            - 1.1.1.1
        environment:
            CORS_ORIGINS: ${CORS_ORIGINS:-*}
            DATABASE_URL: ${DATABASE_URL:-}
            GRPC_PORT: "9090"
            JWT_SECRET: ${JWT_SECRET:-change-me-in-production}
            PAYMENTS_PROVIDER: ${PAYMENTS_PROVIDER:-}
            STRIPE_SECRET_KEY: ${STRIPE_SECRET_KEY:-}
            STRIPE_WEBHOOK_SECRET: ${STRIPE_WEBHOOK_SECRET:-}
        expose:
            - "8080"
        healthcheck:
            interval: 30s
            retries: 3
            test:
                - CMD
                - wget
                - -qO-
                - http://localhost:8080/api/health
            timeout: 5s
        restart: on-failure
volumes:
    caddy_config: {}
    caddy_data: {}
