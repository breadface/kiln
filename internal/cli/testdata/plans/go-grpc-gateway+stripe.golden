{
	email admin@example.com
	# Caddy stores certs in the caddy_data volume — persisted across restarts.
	# No init script, no reload hooks, no certbot. It just works.
}

demo.example.com {
	# --- edge/caddy for backend/go-grpc-gateway (http-service@2) ---
	handle /* {
		reverse_proxy demo-api:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

