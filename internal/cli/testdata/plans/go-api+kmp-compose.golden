==> .github/workflows/deploy.yml <==
name: Deploy

on:
  workflow_dispatch:

concurrency:
  group: deploy
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: docker/setup-buildx-action@v3

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # --- hosting/docker-swarm-hetzner for backend/go-api (http-service@1) ---
      - uses: docker/build-push-action@v5
        with:
          context: ./demo-api
          file: ./demo-api/Dockerfile
          push: true
          tags: |
            ghcr.io/example/demo-api:${{ github.sha }}
            ghcr.io/example/demo-api:latest
          cache-from: type=gha,scope=demo-api
          cache-to: type=gha,mode=max,scope=demo-api

  deploy:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.HETZNER_HOST }}
          username: ${{ secrets.HETZNER_USER }}
          key: ${{ secrets.HETZNER_SSH_KEY }}
          script: |
            set -euo pipefail
            cd ~/demo

            cat > .env <<'ENVEOF'
            # --- hosting/docker-swarm-hetzner for backend/go-api (env@1) ---
            DATABASE_URL=${{ secrets.DATABASE_URL }}
            # --- hosting/docker-swarm-hetzner for backend/go-api (env@1) ---
            JWT_SECRET=${{ secrets.JWT_SECRET }}
            # --- hosting/docker-swarm-hetzner for backend/go-api (env@1) ---
            CORS_ORIGINS=${{ secrets.CORS_ORIGINS }}
            ENVEOF

            docker swarm init >/dev/null 2>&1 || true

            echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u "${{ github.actor }}" --password-stdin

            IMAGE_TAG="${{ github.sha }}"

            docker config inspect "caddyfile_$IMAGE_TAG" >/dev/null 2>&1 || \
              docker config create "caddyfile_$IMAGE_TAG" ./Caddyfile

            # Pull with retry — GHCR can take a moment to propagate a
            # freshly pushed image.
            # --- hosting/docker-swarm-hetzner for backend/go-api (http-service@1) ---
            for i in 1 2 3 4 5; do
              docker pull "ghcr.io/example/demo-api:$IMAGE_TAG" && break
              echo "pull attempt $i failed, retrying..."
              sleep 5
            done

            # --- hosting/docker-swarm-hetzner for backend/go-api (migration@1) ---
            echo "=== Running migrations: demo-api ==="
            docker run --rm \
              --env-file .env \
              "ghcr.io/example/demo-api:$IMAGE_TAG" \
              ./api-server -migrate

            echo "=== Deploying stack ==="
            for i in 1 2 3; do
              IMAGE_TAG=$IMAGE_TAG docker stack deploy \
                --with-registry-auth \
                --prune \
                -c docker-compose.yml \
                -c docker-compose.swarm.yml \
                demo && break
              echo "stack deploy attempt $i failed, retrying..."
              sleep 5
            done

            echo "=== Verifying rollout ==="
            # --- hosting/docker-swarm-hetzner for backend/go-api (http-service@1) ---
            service="demo_demo-api"
            converged=""
            for i in $(seq 1 20); do
              states=$(docker service ps "$service" --filter "desired-state=running" --format '{{.CurrentState}}' 2>/dev/null || true)
              if [ -n "$states" ] && ! echo "$states" | grep -qv '^Running'; then
                converged=1
                break
              fi
              sleep 3
            done
            if [ -z "$converged" ]; then
              echo "rollout did not converge for $service in time" >&2
              docker service ps "$service" || true
              exit 1
            fi
            echo "rollout complete: $service"

            docker image prune -f

==> Caddyfile <==
{
	email admin@example.com
	# Caddy stores certs in the caddy_data volume — persisted across restarts.
	# No init script, no reload hooks, no certbot. It just works.
}

demo.example.com {
	# --- hosting/docker-swarm-hetzner for backend/go-api (http-service@1) ---
	handle /* {
		reverse_proxy demo-api:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

==> deploy.sh <==
#!/bin/bash
# Manual escape hatch — use this on the server if you need to deploy
# without going through GitHub Actions (e.g. a hotfix or CI is down).
#
# Requires: GHCR_TOKEN env var, IMAGE_TAG env var (or defaults to latest)
#
# Usage:
#   IMAGE_TAG=abc1234 GHCR_TOKEN=ghp_xxx ./deploy.sh

set -euo pipefail

IMAGE_TAG=${IMAGE_TAG:-latest}
GITHUB_ACTOR=${GITHUB_ACTOR:-example}

echo "=== Manual deploy: $IMAGE_TAG ==="

echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin

# Create versioned Caddyfile config (skip if already exists — same SHA = same content)
docker config inspect "caddyfile_$IMAGE_TAG" >/dev/null 2>&1 || \
	docker config create "caddyfile_$IMAGE_TAG" ./Caddyfile

# --- hosting/docker-swarm-hetzner for backend/go-api (migration@1) ---
echo "=== Running migrations: demo-api ==="
docker run --rm \
	--env-file .env \
	"ghcr.io/example/demo-api:$IMAGE_TAG" \
	./api-server -migrate

echo "=== Deploying stack ==="
IMAGE_TAG=$IMAGE_TAG docker stack deploy \
	--with-registry-auth \
	--prune \
	-c docker-compose.yml \
	-c docker-compose.swarm.yml \
	demo

docker image prune -f
echo "=== Done ==="

==> docker-compose.swarm.yml <==
# Production overlay — merged on top of docker-compose.yml at deploy time:
#   docker stack deploy -c docker-compose.yml -c docker-compose.swarm.yml \
#     --with-registry-auth demo
#
# docker stack deploy never builds images (Swarm only pulls them), so this
# file adds `image:` per service rather than needing to remove `build:` —
# the base file's `build:` key is simply ignored in Swarm mode. Every
# service is tagged with the same IMAGE_TAG (the commit SHA being deployed).
#
# The caddy service picks up an *externally* created Swarm config here
# (see deploy.sh) instead of relying only on the bind-mounted Caddyfile
# from docker-compose.yml. Swarm configs are immutable and versioned by
# name, so a changed Caddyfile means creating a new named config and
# pointing this file's `configs.caddyfile.name` at it — that's also what
# makes Swarm recognize the caddy service needs to restart at all; a plain
# bind mount's contents changing wouldn't trigger anything on its own.

services:
  # --- hosting/docker-swarm-hetzner for backend/go-api (http-service@1) ---
  demo-api:
    image: ghcr.io/example/demo-api:${IMAGE_TAG:-latest}
    deploy:
      replicas: 1
      update_config:
        order: start-first
        failure_action: rollback
        monitor: 30s
      restart_policy:
        condition: on-failure

  caddy:
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    deploy:
      replicas: 1
      restart_policy:
        condition: any

networks:
  default:
    driver: overlay
    attachable: true # lets standalone containers (e.g. the migration run in deploy.sh) join

configs:
  caddyfile:
    external: true
    name: caddyfile_${IMAGE_TAG:-latest}

==> docker-compose.yml <==
# Generated by kiln from plugins: backend/go-api, mobile/kmp-compose, hosting/docker-swarm-hetzner
services:
    caddy:
        image: caddy:2-alpine
        ports:
            - 80:80
            - 443:443
        restart: always
        volumes:
            - ./Caddyfile:/etc/caddy/Caddyfile:ro
            - caddy_data:/data
            - caddy_config:/config
    demo-api:
        build:
            context: ./demo-api
            dockerfile: Dockerfile
        container_name: demo-api
        dns:
            - 8.8.8.8
            - 1.1.1.1
        environment:
            - DATABASE_URL=${DATABASE_URL}
            - JWT_SECRET=${JWT_SECRET:-change-me-in-production}
            - CORS_ORIGINS=${CORS_ORIGINS:-*}
        expose:
            - "8080"
        healthcheck:
            interval: 30s
            retries: 3
            test:
                - CMD
                - wget
                - -qO-
                - http://localhost:8080/api/health
            timeout: 5s
        restart: on-failure
volumes:
    caddy_config: {}
    caddy_data: {}
