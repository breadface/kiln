version: v2
managed:
  enabled: false
plugins:
  # --- backend/go-grpc-gateway ---
    - remote: buf.build/protocolbuffers/go
      out: demo-api/proto/pb
      opt:
        - paths=source_relative
    - remote: buf.build/grpc/go
      out: demo-api/proto/pb
      opt:
        - paths=source_relative
    - remote: buf.build/grpc-ecosystem/gateway
      out: demo-api/proto/pb
      opt:
        - paths=source_relative

==> deploy.sh <==
#!/bin/bash
# Manual escape hatch — use this on the server if you need to deploy
# without going through GitHub Actions (e.g. a hotfix or CI is down).
#
# Requires: GHCR_TOKEN env var, IMAGE_TAG env var (or defaults to latest)
#
# Usage:
#   IMAGE_TAG=abc1234 GHCR_TOKEN=ghp_xxx ./deploy.sh

set -euo pipefail

IMAGE_TAG=${IMAGE_TAG:-latest}
GITHUB_ACTOR=${GITHUB_ACTOR:-example}

echo "=== Manual deploy: $IMAGE_TAG ==="

echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin

# Create versioned Caddyfile config (skip if already exists — same SHA = same content)
docker config inspect "caddyfile_$IMAGE_TAG" >/dev/null 2>&1 || \
	docker config create "caddyfile_$IMAGE_TAG" ./Caddyfile

# --- hosting/docker-swarm-hetzner for backend/go-grpc-gateway (migration@1) ---
echo "=== Running migrations: demo-api ==="
docker run --rm \
	--env-file .env \
	"ghcr.io/example/demo-api:$IMAGE_TAG" \
	./api-server -migrate

echo "=== Deploying stack ==="
IMAGE_TAG=$IMAGE_TAG docker stack deploy \
	--with-registry-auth \
	--prune \
	-c docker-compose.yml \
	-c docker-compose.swarm.yml \
	demo

docker image prune -f
echo "=== Done ==="

==> docker-compose.swarm.yml <==
# Production overlay — merged on top of docker-compose.yml at deploy time:
#   docker stack deploy -c docker-compose.yml -c docker-compose.swarm.yml \
#     --with-registry-auth demo
#
# docker stack deploy never builds images (Swarm only pulls them), so this
# file adds `image:` per service rather than needing to remove `build:` —
# the base file's `build:` key is simply ignored in Swarm mode. Every
# service is tagged with the same IMAGE_TAG (the commit SHA being deployed).
#
# The caddy service picks up an *externally* created Swarm config here
# (see deploy.sh) instead of relying only on the bind-mounted Caddyfile
# from docker-compose.yml. Swarm configs are immutable and versioned by
# name, so a changed Caddyfile means creating a new named config and
# pointing this file's `configs.caddyfile.name` at it — that's also what
# makes Swarm recognize the caddy service needs to restart at all; a plain
# bind mount's contents changing wouldn't trigger anything on its own.

services:
  # --- hosting/docker-swarm-hetzner for backend/go-grpc-gateway (http-service@1) ---
  demo-api:
    image: ghcr.io/example/demo-api:${IMAGE_TAG:-latest}
    deploy:
      replicas: 1
      update_config:
        order: start-first
        failure_action: rollback
        monitor: 30s
      restart_policy:
        condition: on-failure

  caddy:
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    deploy:
      replicas: 1
      restart_policy:
        condition: any

networks:
  default:
    driver: overlay
    attachable: true # lets standalone containers (e.g. the migration run in deploy.sh) join

configs:
  caddyfile:
    external: true
    name: caddyfile_${IMAGE_TAG:-latest}

==> docker-compose.yml <==
# Generated by kiln from plugins: backend/go-grpc-gateway, hosting/docker-swarm-hetzner
services:
    caddy:
        image: caddy:2-alpine
        ports:
            - 80:80
            - 443:443
        restart: always
        volumes:
            - ./Caddyfile:/etc/caddy/Caddyfile:ro
            - caddy_data:/data
            - caddy_config:/config
    demo-api:
        build:
            context: ./demo-api
            dockerfile: Dockerfile
        container_name: demo-api
        dns:
            - 8.8.8.8
            - 1.1.1.1
        environment:
            - DATABASE_URL=${DATABASE_URL}
            - JWT_SECRET=${JWT_SECRET:-change-me-in-production}
            - CORS_ORIGINS=${CORS_ORIGINS:-*}
            - GRPC_PORT=9090
        expose:
            - "8080"
        healthcheck:
            interval: 30s
            retries: 3
            test:
                - CMD
                - wget
                - -qO-
                - http://localhost:8080/api/health
            timeout: 5s
        restart: on-failure
volumes:
    caddy_config: {}
    caddy_data: {}
